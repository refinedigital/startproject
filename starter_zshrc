
# ==============================================================================
# .zshrc Configuration
# Version: 2.0.0
#
# This file is organized for clarity and optimal path management.
# 1. PATH Modifications: Load new paths.
# 2. Version Managers: Load pyenv, nvm, etc.
# 3. Completions & Integrations: Load command completions.
# 4. User-Defined Variables: Environment variables and keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PATH Modifications (Order is important)
# ------------------------------------------------------------------------------

# Ensure Homebrew is first in your PATH for consistent tool versions.
eval "$(/opt/homebrew/bin/brew shellenv)"

# Add your personal bin directory for custom scripts.
export PATH="$HOME/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"


# ------------------------------------------------------------------------------
# 2. Version Managers (Load after PATH is set)
# ------------------------------------------------------------------------------

# Load pyenv for Python management.
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"

# Load NVM for Node.js management.
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# ------------------------------------------------------------------------------
# 3. Completions & Integrations
# ------------------------------------------------------------------------------

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/refine/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

# Oh My Zsh plugins (Installed by dev_setup.sh, enable here)
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
# The above line was automatically generated by the setup script.

# ------------------------------------------------------------------------------
# 4. User-Defined Variables (Custom Keys, etc.)
# ------------------------------------------------------------------------------

# GEMINI Project Key
export GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Load your Oh My Zsh configuration (this line is added by the installer)
# ------------------------------------------------------------------------------
export ZSH="/Users/refine/.oh-my-zsh"
source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------------------------
# 6. User-Defined Functions
# ------------------------------------------------------------------------------
sudoedit() {
    local tmpfile="/tmp/$(basename "$1").tmp"
    sudo cp "$1" "$tmpfile"
    sudo chown "$USER":"$USER" "$tmpfile"
    code "$tmpfile"
    echo "When done editing, run:"
    echo "sudo tee $1 > /dev/null < $tmpfile"
}

# ------------------------------------------------------------------------------
# 7. User-Defined Commands
# ------------------------------------------------------------------------------
export PATH="$HOME/scripts:$PATH"
alias 'start project'='~/scripts/start_project.sh'
